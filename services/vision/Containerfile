# Use an aarch64 image that matches the target JetPack CUDA/TensorRT ABI.
# Build and validate this image on the Jetson; do not substitute a generic CUDA image.
FROM nvcr.io/nvidia/l4t-tensorrt:r39.2.1-py3
WORKDIR /app
COPY requirements.txt .
RUN python3 -m pip install --no-cache-dir -r requirements.txt
COPY app ./app
EXPOSE 8082
CMD ["python3", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8082"]
