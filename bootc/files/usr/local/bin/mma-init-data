#!/usr/bin/env bash
set -euo pipefail
install -d -m 0750 /var/lib/multimodal-assistant/{models,engines,config,data,cache,logs}
if [[ ! -f /var/lib/multimodal-assistant/config/runtime.env ]]; then
  install -m 0640 /usr/share/multimodal-assistant/runtime.env.example /var/lib/multimodal-assistant/config/runtime.env
fi
